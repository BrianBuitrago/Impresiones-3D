rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Función para verificar si el usuario es ADMIN o COLABORADOR
    function isStaff() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userDoc.rol in ['administrador', 'colaborador'];
    }

    // Función para verificar si el usuario es exclusivamente ADMINISTRADOR
    // (Inversiones, Reportes y Precios son solo para administrador, no para colaborador)
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userDoc.rol == 'administrador';
    }

    // Función para verificar si el usuario es el dueño del documento
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- COLECCIÓN: users ---
    match /users/{userId} {
      // Solo el dueño del perfil o staff pueden leerlo (evita fuga de PII de todos los usuarios)
      allow read: if isOwner(userId) || isStaff();
      // El usuario puede crear su propio perfil al registrarse, pero no con un rol privilegiado
      allow create: if isOwner(userId) && request.resource.data.rol == 'cliente';
      // El dueño puede editar sus datos pero no su propio rol; staff sí puede cambiar roles
      allow update: if isStaff() || (
        isOwner(userId) && request.resource.data.rol == resource.data.rol
      );
      allow delete: if isStaff(); // Solo staff puede borrar usuarios
    }

    // --- COLECCIÓN: quotes (Cotizaciones) ---
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (
        isStaff() ||
        (resource.data.cliente != null && resource.data.cliente.uid == request.auth.uid)
      );
      // Toda creación de cotizaciones pasa por el backend (Admin SDK, ignora estas reglas),
      // que valida y calcula el precio en servidor. No hay escritura directa legítima desde el cliente.
      allow create: if false;
      // Solo el personal (staff) de la aplicación puede modificar o eliminar cotizaciones
      allow update, delete: if isAuthenticated() && isStaff();
    }

    // --- COLECCIÓN: products ---
    match /products/{productId} {
      allow read: if true; // Público
      allow create, update, delete: if isStaff(); // Solo staff
    }

    // --- COLECCIÓN: reports (exclusivo administrador) ---
    match /reports/{reportId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // --- COLECCIÓN: inversiones (exclusivo administrador) ---
    match /inversiones/{inversionId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // --- COLECCIÓN: settings (precios globales, exclusivo administrador para escribir) ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}